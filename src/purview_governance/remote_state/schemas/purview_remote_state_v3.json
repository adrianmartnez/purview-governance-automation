{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fgnfmackk/purview-governance-automation/schemas/purview-remote-state/v3",
  "title": "purview-remote-state v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "targetContext",
    "businessDomains",
    "uninterpretedBusinessDomains",
    "materialStateIdentity"
  ],
  "properties": {
    "apiVersion": {
      "const": "purview-remote-state/v3"
    },
    "targetContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "tenantId", "endpoint", "identity"],
      "properties": {
        "surface": {
          "const": "unifiedCatalog"
        },
        "tenantId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "businessDomains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "properties"],
        "properties": {
          "type": {
            "const": "businessDomain"
          },
          "id": {
            "$ref": "#/$defs/uuid"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "parentId": {
                "$ref": "#/$defs/uuid"
              },
              "status": {
                "type": "string",
                "enum": ["DRAFT", "PUBLISHED", "EXPIRED"]
              },
              "type": {
                "type": "string",
                "enum": [
                  "FunctionalUnit",
                  "LineOfBusiness",
                  "DataDomain",
                  "Regulatory",
                  "Project"
                ]
              },
              "isRestricted": {
                "type": "boolean"
              }
            }
          },
          "unsupportedConfigurableFields": {
            "$ref": "#/$defs/unsupportedConfigurableFields"
          }
        }
      }
    },
    "uninterpretedBusinessDomains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uninterpretedBusinessDomain"
      }
    },
    "capturedResourceTypes": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "businessDomain" },
            { "const": "dataProduct" }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "businessDomain" },
            { "const": "glossaryTerm" }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "businessDomain" },
            { "const": "dataProduct" },
            { "const": "glossaryTerm" }
          ],
          "items": false
        }
      ]
    },
    "dataProducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedDataProduct"
      }
    },
    "uninterpretedDataProducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uninterpretedDataProduct"
      }
    },
    "glossaryTerms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedGlossaryTerm"
      }
    },
    "uninterpretedGlossaryTerms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uninterpretedGlossaryTerm"
      }
    },
    "readModelCoverage": {
      "$ref": "#/$defs/readModelCoverage"
    },
    "dataAssets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedDataAsset"
      }
    },
    "uninterpretedDataAssets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uninterpretedDataAsset"
      }
    },
    "dataColumns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedDataColumn"
      }
    },
    "uninterpretedDataColumns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uninterpretedDataColumn"
      }
    },
    "governanceRelationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedGovernanceRelationship"
      }
    },
    "uninterpretedGovernanceRelationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uninterpretedGovernanceRelationship"
      }
    },
    "materialStateIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["capturedResourceTypes"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "capturedResourceTypes": {
                "prefixItems": [
                  { "const": "businessDomain" },
                  { "const": "dataProduct" }
                ]
              }
            },
            "required": ["dataProducts", "uninterpretedDataProducts"],
            "not": { "required": ["glossaryTerms"] }
          },
          {
            "properties": {
              "capturedResourceTypes": {
                "prefixItems": [
                  { "const": "businessDomain" },
                  { "const": "glossaryTerm" }
                ]
              }
            },
            "required": ["glossaryTerms", "uninterpretedGlossaryTerms"],
            "not": { "required": ["dataProducts"] }
          },
          {
            "properties": {
              "capturedResourceTypes": {
                "prefixItems": [
                  { "const": "businessDomain" },
                  { "const": "dataProduct" },
                  { "const": "glossaryTerm" }
                ]
              }
            },
            "required": [
              "dataProducts",
              "uninterpretedDataProducts",
              "glossaryTerms",
              "uninterpretedGlossaryTerms"
            ]
          }
        ]
      },
      "else": {
        "properties": {
          "capturedResourceTypes": false,
          "dataProducts": false,
          "uninterpretedDataProducts": false,
          "glossaryTerms": false,
          "uninterpretedGlossaryTerms": false
        }
      }
    },
    {
      "if": {
        "required": ["readModelCoverage"]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "readModelCoverage": {
                  "properties": {
                    "dataAssets": { "const": true }
                  },
                  "required": ["dataAssets"]
                }
              }
            },
            "then": {
              "required": ["dataAssets", "uninterpretedDataAssets"]
            }
          },
          {
            "if": {
              "properties": {
                "readModelCoverage": {
                  "properties": {
                    "dataColumns": { "const": true }
                  },
                  "required": ["dataColumns"]
                }
              }
            },
            "then": {
              "required": ["dataColumns", "uninterpretedDataColumns"]
            }
          },
          {
            "if": {
              "properties": {
                "readModelCoverage": {
                  "properties": {
                    "governanceRelationships": {
                      "type": "object",
                      "minProperties": 1
                    }
                  },
                  "required": ["governanceRelationships"]
                }
              }
            },
            "then": {
              "required": [
                "governanceRelationships",
                "uninterpretedGovernanceRelationships"
              ]
            }
          }
        ]
      },
      "else": {
        "properties": {
          "readModelCoverage": false,
          "dataAssets": false,
          "uninterpretedDataAssets": false,
          "dataColumns": false,
          "uninterpretedDataColumns": false,
          "governanceRelationships": false,
          "uninterpretedGovernanceRelationships": false
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dataProductType": {
      "type": "string",
      "enum": [
        "Master",
        "Reference",
        "Analytical",
        "AI",
        "MasterDataAndReferenceData",
        "BusinessSystemOrApplication",
        "ModelTypes",
        "DashboardsOrReports",
        "Operational",
        "MLAITrainingDataSet",
        "MLAITestingDataSet",
        "TransactionalDataset",
        "AnalyticsModel",
        "SemanticModel"
      ]
    },
    "dataProductOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "unsupportedConfigurableField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "valueIdentity"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "valueIdentity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "unsupportedConfigurableFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unsupportedConfigurableField"
      }
    },
    "uninterpretedBusinessDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uninterpretedDataProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedDataProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "properties", "safetyProperties"],
      "properties": {
        "type": {
          "const": "dataProduct"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "domain", "type", "description", "businessUse"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "$ref": "#/$defs/dataProductType"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "businessUse": {
              "type": "string",
              "minLength": 1
            },
            "owners": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dataProductOwner"
              }
            },
            "audience": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "DataEngineer",
                  "BIEngineer",
                  "DataAnalyst",
                  "DataScientist",
                  "BusinessAnalyst",
                  "SoftwareEngineer",
                  "BusinessUser",
                  "Executive"
                ]
              }
            },
            "updateFrequency": {
              "type": "string",
              "enum": [
                "Hourly",
                "Daily",
                "Weekly",
                "Monthly",
                "Quarterly",
                "Yearly"
              ]
            },
            "endorsed": {
              "type": "boolean"
            }
          }
        },
        "safetyProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["DRAFT", "PUBLISHED", "EXPIRED"]
            },
            "provisioningState": {
              "type": "string",
              "enum": ["Unknown", "Succeeded", "SoftDeleted"]
            }
          }
        },
        "unsupportedConfigurableFields": {
          "$ref": "#/$defs/unsupportedConfigurableFields"
        }
      }
    },
    "uninterpretedGlossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedGlossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "properties", "safetyProperties"],
      "properties": {
        "type": {
          "const": "glossaryTerm"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "domain", "description"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "$ref": "#/$defs/uuid"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "owners": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dataProductOwner"
              }
            },
            "parentId": {
              "$ref": "#/$defs/uuid"
            },
            "acronyms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "safetyProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["DRAFT", "PUBLISHED", "EXPIRED"]
            },
            "provisioningState": {
              "type": "string",
              "enum": ["Unknown", "Succeeded", "SoftDeleted"]
            }
          }
        },
        "unsupportedConfigurableFields": {
          "$ref": "#/$defs/unsupportedConfigurableFields"
        }
      }
    },
    "readModelCoverage": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "dataAssets": {
          "const": true
        },
        "dataColumns": {
          "const": true
        },
        "governanceRelationships": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "dataProductToDataAsset": {
              "const": true
            },
            "glossaryTermToDataAsset": {
              "const": true
            },
            "glossaryTermToDataColumn": {
              "const": true
            }
          }
        }
      }
    },
    "uninterpretedDataAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedDataAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "name", "assetType"],
      "properties": {
        "type": {
          "const": "dataAsset"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "assetType": {
          "type": "string",
          "enum": ["General", "AzureSqlTable", "ADLSGen2Path"]
        },
        "description": {
          "type": "string"
        },
        "openInUrl": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "assetId",
            "assetType",
            "fqn",
            "accountName",
            "assetAttributes"
          ],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "assetId": { "$ref": "#/$defs/uuid" },
            "assetType": { "type": "string", "minLength": 1 },
            "fqn": { "type": "string", "minLength": 1 },
            "accountName": { "type": "string", "minLength": 1 },
            "assetAttributes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "contacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "array",
              "items": { "$ref": "#/$defs/dataProductOwner" }
            },
            "expert": {
              "type": "array",
              "items": { "$ref": "#/$defs/dataProductOwner" }
            },
            "databaseAdmin": {
              "type": "array",
              "items": { "$ref": "#/$defs/dataProductOwner" }
            }
          }
        },
        "classifications": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "type": { "type": "string", "minLength": 1 },
              "classifications": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "typeProperties": {
          "type": "object"
        },
        "safetyProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provisioningState": {
              "type": "string",
              "enum": ["Unknown", "Succeeded", "SoftDeleted"]
            }
          }
        }
      }
    },
    "uninterpretedDataColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedDataColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "columnType", "source"],
      "properties": {
        "type": {
          "const": "dataColumn"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columnType": {
          "type": "string",
          "enum": ["General", "AzureSqlColumn", "ADLSGen2Path"]
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "assetId",
            "columnId",
            "assetType",
            "fqn",
            "accountName",
            "assetAttributes"
          ],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "assetId": { "$ref": "#/$defs/uuid" },
            "columnId": { "$ref": "#/$defs/uuid" },
            "assetType": { "type": "string", "minLength": 1 },
            "fqn": { "type": "string", "minLength": 1 },
            "accountName": { "type": "string", "minLength": 1 },
            "assetAttributes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "columnDetails": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "dataType": { "type": "string" },
            "isNullable": { "type": "boolean" },
            "ordinalPosition": { "type": "integer" },
            "maxLength": { "type": "integer" },
            "precision": { "type": "integer" },
            "scale": { "type": "integer" }
          }
        },
        "assetDetails": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "assetId": { "type": "string" },
            "assetType": { "type": "string" },
            "fqn": { "type": "string" },
            "accountName": { "type": "string" },
            "name": { "type": "string" },
            "assetAttributes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "normalizedGovernanceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sourceType",
        "sourceId",
        "targetCategory",
        "targetId",
        "relationshipType"
      ],
      "properties": {
        "type": {
          "const": "governanceRelationship"
        },
        "sourceType": {
          "type": "string",
          "enum": ["dataProduct", "glossaryTerm"]
        },
        "sourceId": {
          "$ref": "#/$defs/uuid"
        },
        "targetCategory": {
          "type": "string",
          "enum": ["DATAASSET", "DATACOLUMN"]
        },
        "targetId": {
          "$ref": "#/$defs/uuid"
        },
        "relationshipType": {
          "type": "string",
          "enum": ["Related"]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "uninterpretedGovernanceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "sourceType", "sourceId", "targetCategory"],
      "properties": {
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "type": "string",
          "enum": ["dataProduct", "glossaryTerm"]
        },
        "sourceId": {
          "$ref": "#/$defs/uuid"
        },
        "targetCategory": {
          "type": "string",
          "enum": ["DATAASSET", "DATACOLUMN"]
        },
        "targetId": {
          "$ref": "#/$defs/uuid"
        },
        "relationshipType": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
