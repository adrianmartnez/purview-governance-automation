{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fgnfmackk/purview-governance-automation/schemas/purview-governance-config/v2",
  "title": "purview-governance-config v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "target", "authentication", "resources"],
  "properties": {
    "apiVersion": {
      "const": "purview-governance-config/v2"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "const": "defaultAzureCredential"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "kind", "properties"],
            "properties": {
              "type": { "const": "dataSource" },
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 63,
                "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
              },
              "kind": { "const": "AzureStorage" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["endpoint", "collection"],
                "properties": {
                  "endpoint": { "type": "string", "minLength": 1 },
                  "collection": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["referenceName"],
                    "properties": {
                      "referenceName": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "kind", "scanRulesetType", "properties"],
            "properties": {
              "type": { "const": "scanRuleSet" },
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 63,
                "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
              },
              "kind": { "const": "AzureStorage" },
              "scanRulesetType": { "const": "Custom" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scanningRule",
                  "excludedSystemClassifications",
                  "includedCustomClassificationRuleNames"
                ],
                "properties": {
                  "scanningRule": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fileExtensions"],
                    "properties": {
                      "fileExtensions": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "excludedSystemClassifications": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "includedCustomClassificationRuleNames": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "description": { "type": "string" }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "kind", "properties"],
            "properties": {
              "type": { "const": "scan" },
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 63,
                "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
              },
              "kind": { "const": "AzureStorageMsi" },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dataSourceName",
                  "scanRulesetName",
                  "scanRulesetType",
                  "collection"
                ],
                "properties": {
                  "dataSourceName": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 63,
                    "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
                  },
                  "scanRulesetName": { "type": "string", "minLength": 1 },
                  "scanRulesetType": {
                    "type": "string",
                    "enum": ["System", "Custom"]
                  },
                  "collection": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["referenceName"],
                    "properties": {
                      "referenceName": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
