{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fgnfmackk/purview-governance-automation/schemas/purview-governance-config/v3",
  "title": "purview-governance-config v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "target", "authentication", "resources"],
  "properties": {
    "apiVersion": {
      "const": "purview-governance-config/v3"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "tenantId"],
      "properties": {
        "surface": {
          "const": "unifiedCatalog"
        },
        "tenantId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "const": "defaultAzureCredential"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "properties"],
        "properties": {
          "type": {
            "const": "businessDomain"
          },
          "id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "parentId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "status": {
                "type": "string",
                "enum": ["DRAFT", "PUBLISHED", "EXPIRED"]
              },
              "type": {
                "type": "string",
                "enum": [
                  "FunctionalUnit",
                  "LineOfBusiness",
                  "DataDomain",
                  "Regulatory",
                  "Project"
                ]
              },
              "isRestricted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
