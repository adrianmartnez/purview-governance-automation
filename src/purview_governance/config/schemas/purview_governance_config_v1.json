{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fgnfmackk/purview-governance-automation/schemas/purview-governance-config/v1",
  "title": "purview-governance-config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "target", "authentication", "resources"],
  "properties": {
    "apiVersion": {
      "const": "purview-governance-config/v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "const": "defaultAzureCredential"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "kind", "properties"],
        "properties": {
          "type": {
            "const": "dataSource"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
          },
          "kind": {
            "const": "AzureStorage"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpoint", "collection"],
            "properties": {
              "endpoint": {
                "type": "string",
                "minLength": 1
              },
              "collection": {
                "type": "object",
                "additionalProperties": false,
                "required": ["referenceName"],
                "properties": {
                  "referenceName": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
